# Database connection (PostgreSQL in production/Docker, SQLite for local dev)
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/semantic_diff_db

# Security & JWT Token Secrets (Generate with `openssl rand -hex 32`)
SECRET_KEY=change-this-in-production-secret-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM API configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ML Embeddings (Set to 1 for fast offline mode without downloading PyTorch weights)
DISABLE_HEAVY_EMBEDDINGS=0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# File Upload Storage
UPLOAD_DIR=./data/uploads
STORAGE_BACKEND=local

# Optional Neo4j Knowledge Graph Store
DEFAULT_GRAPH_STORE=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
